PORT=3001
# Match apps/web `pnpm dev` origin (next dev -H 127.0.0.1 -p 43147).
CORS_ORIGIN=http://127.0.0.1:43147
SESSION_TTL_MINUTES=60
AUTH_SECRET=replace-with-at-least-32-random-characters

# Persistence: omit both settings (or SESSION_STORE=memory) for in-memory.
# File database on this computer, same tables, survives API restarts:
# SESSION_STORE=pglite
# PGLITE_DATA_DIR=.data/discovery
# Postgres via Docker (infra/docker-compose.yml):
# DATABASE_URL=postgresql://valuecurator:valuecurator@127.0.0.1:5432/valuecurator_discovery
# SESSION_STORE=postgres
