{
  "name": "@valuecurator/discovery-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "test": "vitest run",
    "check": "tsc -p tsconfig.build.json --noEmit",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@valuecurator/discovery-contracts": "workspace:*",
    "@fastify/cors": "^10.0.0",
    "bs58": "^6.0.0",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.44.5",
    "fastify": "^5.0.0",
    "postgres": "^3.4.7",
    "tweetnacl": "^1.0.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.4",
    "@types/node": "^22.7.4",
    "drizzle-kit": "^0.31.4",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vitest": "^2.1.1"
  }
}
