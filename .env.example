# Copy relevant values into each app's local .env / .env.local.
# Do not commit secrets.

# --- apps/discovery-api ---
PORT=3001
# Must match the Next.js origin used by `pnpm dev:web` (127.0.0.1:43147).
CORS_ORIGIN=http://127.0.0.1:43147
SESSION_TTL_MINUTES=60
AUTH_SECRET=replace-with-at-least-32-random-characters

# --- apps/web ---
NEXT_PUBLIC_DISCOVERY_API_URL=http://localhost:3001
NEXT_PUBLIC_RPC_URL=https://api.devnet.solana.com
NEXT_PUBLIC_PROGRAM_ID=6owAcXj4FxJom96cEX9CSFjGrg6zp4U8atTjrpCUMiW5
